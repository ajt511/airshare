<?xml version="1.0" encoding="utf-8"?>
<!-- Window events plus a bounded node-tree read: galleries put the viewed
     image's file name into contentDescription, which PhotoContentGrabber
     matches against MediaStore to send the original. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="200"
    android:description="@string/photo_gesture_service_desc" />
